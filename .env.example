# Safe local-demo values only. Replace all credentials outside local development.
KITCHEN_DATABASE_URL=postgres://kitchen:kitchen@localhost:5432/kitchen?sslmode=disable
RESTAURANT_DATABASE_URL=postgres://restaurant:restaurant@localhost:5433/restaurant?sslmode=disable
KITCHEN_HTTP_ADDR=:8080
RESTAURANT_HTTP_ADDR=:8081
KITCHEN_API_URL=http://localhost:8080
DEMO_PARTNER_API_KEY=demo-partner-key-change-me
INTEGRATION_API_KEY=demo-integration-key-change-me
WORKER_POLL_INTERVAL=250ms
WORKER_HTTP_TIMEOUT=2s
WORKER_MAX_ATTEMPTS=5
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576
LOG_LEVEL=info
